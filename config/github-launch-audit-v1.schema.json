{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tyler-vault.invalid/contracts/github-launch-audit-v1.schema.json",
  "title": "One-time GitHub repository launch audit v1",
  "description": "A bounded, human-readable and hashable audit record for the repository visibility boundary. Every lifecycle phase has an authenticated complete GitHub API machine-evidence lane; UI is optional corroboration. The record does not claim that unknown clones or cached views are absent and does not contain Pages browser QA.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "audit_kind",
    "repository",
    "summary",
    "created_at",
    "visibility_changed_at",
    "completed_at",
    "finalized_at",
    "scope",
    "evidence",
    "findings",
    "limitations",
    "approvals",
    "audit_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "audit_id": { "type": "string", "pattern": "^launch-audit-[a-z0-9][a-z0-9-]{0,100}$" },
    "audit_kind": { "const": "one-time-launch-audit" },
    "repository": { "$ref": "#/definitions/repository" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "created_at": { "$ref": "#/definitions/date_time" },
    "visibility_changed_at": { "$ref": "#/definitions/date_time" },
    "completed_at": {
      "$ref": "#/definitions/date_time",
      "description": "Completion time for the post-visibility repository/API/UI/anonymous-repository readback phase."
    },
    "finalized_at": {
      "$ref": "#/definitions/date_time",
      "description": "Time at which this launch-audit record was finalized after post-visibility readback."
    },
    "scope": { "$ref": "#/definitions/scope" },
    "evidence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 64,
      "items": { "$ref": "#/definitions/evidence" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["phase", "source", "authentication", "pagination"],
            "properties": {
              "phase": { "const": "previsibility_audit" },
              "source": { "const": "github-api" },
              "authentication": { "const": "authenticated" },
              "pagination": { "const": "complete" }
            }
          },
          "description": "At least one previsibility authenticated complete GitHub API machine evidence is mandatory."
        },
        {
          "contains": {
            "type": "object",
            "required": ["phase", "source", "authentication", "pagination"],
            "properties": {
              "phase": { "const": "post_visibility_readback" },
              "source": { "const": "github-api" },
              "authentication": { "const": "authenticated" },
              "pagination": { "const": "complete" }
            }
          },
          "description": "At least one postvisibility authenticated complete GitHub API machine evidence is mandatory."
        }
      ]
    },
    "findings": { "$ref": "#/definitions/findings" },
    "limitations": { "$ref": "#/definitions/limitations" },
    "approvals": { "$ref": "#/definitions/approvals" },
    "audit_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of RFC 8785-style canonical JSON with this audit_digest member omitted."
    }
  },
  "definitions": {
    "date_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/definitions/non_empty_string" }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "html_url", "default_branch", "target_visibility"],
      "properties": {
        "owner": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "html_url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "default_branch": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "target_visibility": { "const": "public" }
      }
    },
    "local_mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "root", "checks"],
      "properties": {
        "required": { "const": true },
        "root": { "$ref": "#/definitions/non_empty_string" },
        "checks": { "$ref": "#/definitions/non_empty_string_array" }
      }
    },
    "previsibility_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "local_mirror", "checks"],
      "properties": {
        "required": { "const": true },
        "local_mirror": { "$ref": "#/definitions/local_mirror" },
        "checks": { "$ref": "#/definitions/non_empty_string_array" }
      }
    },
    "machine_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "single_lane", "transport", "authentication", "pagination", "checks"],
      "properties": {
        "required": { "const": true },
        "single_lane": { "const": true },
        "transport": { "enum": ["gh-api-paginate", "authenticated-github-api"] },
        "authentication": { "const": "authenticated" },
        "pagination": { "const": "complete" },
        "checks": { "$ref": "#/definitions/non_empty_string_array" }
      }
    },
    "ui_corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "role"],
      "properties": {
        "required": { "const": false },
        "role": { "const": "corroboration-only" }
      }
    },
    "authenticated_github_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "machine_lane"],
      "properties": {
        "required": { "const": true },
        "machine_lane": { "$ref": "#/definitions/machine_lane" },
        "ui_corroboration": { "$ref": "#/definitions/ui_corroboration" }
      }
    },
    "post_visibility_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "after_visibility_change", "surfaces", "checks"],
      "properties": {
        "required": { "const": true },
        "after_visibility_change": { "const": true },
        "surfaces": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["repository", "api", "ui", "anonymous-repository"] },
          "allOf": [
            { "contains": { "const": "repository" } },
            { "contains": { "const": "api" } },
            { "contains": { "const": "anonymous-repository" } }
          ]
        },
        "checks": { "$ref": "#/definitions/non_empty_string_array" }
      }
    },
    "anonymous_repository_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "after_visibility_change", "authentication", "checks"],
      "properties": {
        "required": { "const": true },
        "after_visibility_change": { "const": true },
        "authentication": { "const": "none" },
        "checks": { "$ref": "#/definitions/non_empty_string_array" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_phases",
        "previsibility_audit",
        "authenticated_github_evidence",
        "post_visibility_readback",
        "anonymous_repository_readback",
        "source_commit",
        "sealed_artifact_digest"
      ],
      "properties": {
        "lifecycle_phases": {
          "type": "array",
          "const": ["previsibility_audit", "visibility_approval", "post_visibility_readback", "finalize_launch_audit"]
        },
        "previsibility_audit": { "$ref": "#/definitions/previsibility_audit" },
        "authenticated_github_evidence": { "$ref": "#/definitions/authenticated_github_evidence" },
        "post_visibility_readback": { "$ref": "#/definitions/post_visibility_readback" },
        "anonymous_repository_readback": { "$ref": "#/definitions/anonymous_repository_readback" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sealed_artifact_digest": { "$ref": "#/definitions/sha256" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 6,
      "required": ["surface", "result", "checks"],
      "description": "Bounded canonical observation projection. It retains only human-readable surface/result/check names and small summary facts; it never requires a raw GitHub response, credential, or token.",
      "properties": {
        "surface": { "enum": ["local-mirror", "repository", "api", "ui", "anonymous-repository"] },
        "result": { "enum": ["clear", "findings", "not-provable"] },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "visibility": { "enum": ["private", "public", "not-observed"] },
        "default_branch": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 255 },
        "approved_path_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "control_plane_state": { "enum": ["matching", "mismatch", "not-observed"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "plane",
        "source",
        "locator",
        "authentication",
        "pagination",
        "observed_at",
        "result",
        "finding_ids",
        "observation",
        "summary",
        "evidence_digest"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{0,100}$" },
        "phase": { "enum": ["previsibility_audit", "post_visibility_readback"] },
        "plane": { "enum": ["public-content-audit", "github-control-plane"] },
        "source": { "enum": ["local-mirror", "github-repository", "github-api", "github-ui", "anonymous-repository"] },
        "locator": { "$ref": "#/definitions/non_empty_string" },
        "authentication": { "enum": ["none", "authenticated"] },
        "pagination": { "enum": ["complete", "not-applicable", "not-provable"] },
        "observed_at": { "$ref": "#/definitions/date_time" },
        "result": { "enum": ["clear", "findings", "not-provable"] },
        "finding_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,100}$" }
        },
        "observation": { "$ref": "#/definitions/observation" },
        "summary": { "$ref": "#/definitions/non_empty_string" },
        "evidence_digest": { "$ref": "#/definitions/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source": { "const": "local-mirror" } },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "phase": { "const": "previsibility_audit" },
              "plane": { "const": "public-content-audit" },
              "authentication": { "const": "none" },
              "pagination": { "const": "not-applicable" },
              "observation": { "type": "object", "properties": { "surface": { "const": "local-mirror" } } }
            }
          }
        },
        {
          "if": {
            "properties": { "source": { "const": "github-api" } },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "plane": { "const": "github-control-plane" },
              "authentication": { "const": "authenticated" },
              "pagination": { "const": "complete" },
              "observation": { "type": "object", "properties": { "surface": { "const": "api" } } }
            }
          }
        },
        {
          "if": {
            "properties": { "source": { "const": "github-repository" } },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "phase": { "const": "post_visibility_readback" },
              "plane": { "const": "github-control-plane" },
              "authentication": { "const": "authenticated" },
              "pagination": { "const": "not-applicable" },
              "observation": { "type": "object", "properties": { "surface": { "const": "repository" } } }
            }
          }
        },
        {
          "if": {
            "properties": { "source": { "const": "github-ui" } },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "phase": { "const": "post_visibility_readback" },
              "plane": { "const": "github-control-plane" },
              "authentication": { "const": "authenticated" },
              "pagination": { "const": "not-applicable" },
              "observation": { "type": "object", "properties": { "surface": { "const": "ui" } } }
            }
          }
        },
        {
          "if": {
            "properties": { "source": { "const": "anonymous-repository" } },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "phase": { "const": "post_visibility_readback" },
              "plane": { "const": "github-control-plane" },
              "authentication": { "const": "none" },
              "pagination": { "const": "not-applicable" },
              "observation": { "type": "object", "properties": { "surface": { "const": "anonymous-repository" } } }
            }
          }
        },
        {
          "if": { "properties": { "result": { "const": "findings" } }, "required": ["result"] },
          "then": { "properties": { "finding_ids": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": {
            "properties": { "result": { "enum": ["clear", "not-provable"] } },
            "required": ["result"]
          },
          "then": { "properties": { "finding_ids": { "type": "array", "maxItems": 0 } } }
        }
      ]
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "counts", "items"],
      "properties": {
        "status": { "enum": ["clear", "blocked", "remediated"] },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secret", "rights_unknown", "disallowed_output", "control_plane", "repository"],
          "properties": {
            "secret": { "type": "integer", "minimum": 0 },
            "rights_unknown": { "type": "integer", "minimum": 0 },
            "disallowed_output": { "type": "integer", "minimum": 0 },
            "control_plane": { "type": "integer", "minimum": 0 },
            "repository": { "type": "integer", "minimum": 0 }
          }
        },
        "items": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "category", "severity", "description", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,100}$" },
              "category": { "enum": ["secret", "rights_unknown", "disallowed_output", "control_plane", "repository"] },
              "severity": { "enum": ["high", "medium", "low", "informational"] },
              "description": { "$ref": "#/definitions/non_empty_string" },
              "status": { "enum": ["open", "remediated", "accepted"] }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_clones_and_cached_views", "unknown_external_copies", "zero_gate", "statement"],
      "properties": {
        "known_clones_and_cached_views": { "$ref": "#/definitions/non_zero_gate_limitation" },
        "unknown_external_copies": { "$ref": "#/definitions/non_zero_gate_limitation" },
        "zero_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_for_launch", "reason"],
          "properties": {
            "required_for_launch": { "const": false },
            "reason": { "$ref": "#/definitions/non_empty_string" }
          }
        },
        "statement": { "$ref": "#/definitions/non_empty_string" }
      }
    },
    "non_zero_gate_limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "zero_gate", "note"],
      "properties": {
        "status": { "const": "not-provable" },
        "zero_gate": { "const": false },
        "note": { "$ref": "#/definitions/non_empty_string" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "approved_by", "approved_at", "reference"],
      "properties": {
        "required": { "const": true },
        "status": { "const": "approved" },
        "approved_by": { "$ref": "#/definitions/non_empty_string" },
        "approved_at": { "$ref": "#/definitions/date_time" },
        "reference": { "$ref": "#/definitions/non_empty_string" }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility"],
      "properties": {
        "visibility": { "$ref": "#/definitions/approval" }
      }
    }
  }
}
