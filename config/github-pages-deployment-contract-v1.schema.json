        "best_effort": { "const": true },
        "method": { "const": "best-effort non-recursive rmdir of the checked empty directory" },
        "checks_before_rmdir": { "const": "no-link and matching dev/ino checks immediately before rmdir" },
        "resistance": { "const": "does not claim resistance to a compromised or cooperating same-user writer" },
