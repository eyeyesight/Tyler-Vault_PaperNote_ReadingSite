{
  "name": "tyler-vault-reading-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "scripts": {
    "slim:preflight": "node scripts/slim-build.mjs preflight",
    "slim:build": "node scripts/slim-build.mjs build",
    "gh-pages:prepare": "node scripts/prepare-gh-pages-commit.mjs",
    "vault:papernote:publish": "node scripts/vault-papernote-publish.mjs",
    "vault:papernote:site": "node scripts/vault-papernote-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1",
    "test:slim": "node --test tests/slim-build.test.mjs",
    "test:gh-pages": "node --test tests/prepare-gh-pages-commit.test.mjs tests/github-pages-workflow.test.mjs"
  },
  "dependencies": {
    "@jackyzha0/quartz": "https://github.com/jackyzha0/quartz/archive/507ad7f3d4601d83482f61930fccf1c77f42a072.tar.gz",
    "ajv": "8.20.0",
    "brace-expansion": "file:vendor/brace-expansion-compat",
    "mdast-util-from-markdown": "2.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "hast-util-from-html": "^2.0.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion",
    "sharp": "0.35.3"
  }
}
