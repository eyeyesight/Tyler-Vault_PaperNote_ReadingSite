{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tyler-vault-site.local/schemas/publication-manifest-v1.schema.json",
  "title": "Tyler-Vault Publication Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "created_at",
    "expires_at",
    "approval_receipt",
    "action",
    "nodes",
    "public_set_digest",
    "plan_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": {
      "type": "string",
      "pattern": "^VPUB-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "created_at": { "$ref": "#/$defs/utcTimestamp" },
    "expires_at": { "$ref": "#/$defs/utcTimestamp" },
    "approval_receipt": { "$ref": "#/$defs/approvalReceipt" },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/publishUnitAction" },
        { "$ref": "#/$defs/zoteroRefreshAction" }
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/node" }
    },
    "public_set_digest": { "$ref": "#/$defs/sha256" },
    "plan_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "publicId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "vaultRelativeMarkdownPath": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?!/)[^\\\\\\u0000]+\\.md$",
      "allOf": [
        { "not": { "pattern": "(^|/)\\.\\.(?:/|$)" } },
        { "not": { "pattern": "^[A-Za-z]:" } }
      ]
    },
    "consumedReceiptPath": {
      "type": "string",
      "minLength": 20,
      "pattern": "^consumed/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$",
      "not": { "pattern": "(^|/)\\.\\.(?:/|$)" }
    },
    "approvalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approver",
        "channel",
        "source_event_id",
        "approved_plan_digest",
        "approved_at"
      ],
      "properties": {
        "approver": { "const": "tyler" },
        "channel": { "const": "telegram" },
        "source_event_id": { "type": "string", "minLength": 1 },
        "approved_plan_digest": { "$ref": "#/$defs/sha256" },
        "approved_at": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/publicId" },
        "target": { "$ref": "#/$defs/publicId" }
      }
    },
    "genesisBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "genesis" }
      }
    },
    "releaseBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "release_digest", "receipt_path"],
      "properties": {
        "kind": { "const": "release" },
        "release_digest": { "$ref": "#/$defs/sha256" },
        "receipt_path": { "$ref": "#/$defs/consumedReceiptPath" }
      }
    },
    "publishUnitAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "baseline",
        "primary_id",
        "support_ids",
        "added_node_ids",
        "direct_connection_edges"
      ],
      "properties": {
        "kind": { "const": "publish-unit" },
        "baseline": {
          "oneOf": [
            { "$ref": "#/$defs/genesisBaseline" },
            { "$ref": "#/$defs/releaseBaseline" }
          ]
        },
        "primary_id": { "$ref": "#/$defs/publicId" },
        "support_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/publicId" }
        },
        "added_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/publicId" }
        },
        "direct_connection_edges": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "zoteroRefreshAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_id",
        "baseline_release_digest",
        "baseline_receipt_path"
      ],
      "properties": {
        "kind": { "const": "zotero-refresh" },
        "target_id": { "$ref": "#/$defs/publicId" },
        "baseline_release_digest": { "$ref": "#/$defs/sha256" },
        "baseline_receipt_path": { "$ref": "#/$defs/consumedReceiptPath" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "path", "node_class", "source_sha256"],
      "properties": {
        "public_id": { "$ref": "#/$defs/publicId" },
        "path": { "$ref": "#/$defs/vaultRelativeMarkdownPath" },
        "node_class": {
          "enum": [
            "paper",
            "concept",
            "method",
            "task",
            "author",
            "synthesis",
            "map"
          ]
        },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
