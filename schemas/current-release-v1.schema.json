{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tyler-vault-site.local/schemas/current-release-v1.schema.json",
  "title": "Tyler-Vault Current Release Pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_digest", "receipt_path"],
  "properties": {
    "schema_version": { "const": 1 },
    "release_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_path": {
      "type": "string",
      "minLength": 6,
      "pattern": "^consumed/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$",
      "not": { "pattern": "(^|/)\\.\\.(?:/|$)" }
    }
  }
}
